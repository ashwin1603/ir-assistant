APP_ENV=development
DATABASE_URL=sqlite:///./ir_assistant.db

JWT_SECRET=changeme-generate-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

COLLECTOR_API_KEY=changeme-generate-a-random-key

CORS_ORIGIN=http://localhost:5173

LLM_PROVIDER=template
LLM_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_PREDICT=150
OLLAMA_NUM_CTX=2048
OLLAMA_KEEP_ALIVE=30m
AI_CALLS_PER_HOUR=20

ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme-pick-a-strong-password
# setup.ps1 generates a Fernet key. Keep it stable; losing it makes encrypted MFA secrets unreadable.
DATA_ENCRYPTION_KEY=
EXPORT_QUOTA_COUNT=30
EXPORT_QUOTA_MINUTES=60

RATE_LIMIT_ENABLED=true

# Uploaded log files (stored with random names, never served)
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=20
